   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "Xn = np.arange(1,5,1)\n",
    "print(Xn)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "2f64709d-8329-4841-8b63-d56d853ef53d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[4, 3, 2, 1]\n"
     ]
    }
   ],
   "source": [
    "Xn = [1,2,3,4]\n",
    "xnf= Xn\n",
    "xnf.reverse()\n",
    "print(xnf)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "9696f356-17b9-4ecb-8d8c-4c9f9979b9bb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[16 24 25 20 10  4  1]\n"
     ]
    }
   ],
   "source": [
    "Yn = np.convolve(Xn, xnf,mode=\"full\")\n",
    "print(Yn)"
   ]
  },
  {
   "cell_type": "code",
